{"ts": "2026-11-07T17:17:27.782+00:00", "run": "hand", "type": "proposed", "id": "H0001", "source": "hand", "batch": null, "raw": {"statement": "Players who lost their previous game within 5 minutes underperform their rating in the next game", "subset": [], "condition": [{"feature": "prev_result", "op": "==", "value": "loss"}, {"feature": "minutes_since_prev_game", "op": "<=", "value": 5}], "comparison": "rest_of_subset", "outcome": "residual", "direction": "less", "min_effect": 0.005, "rationale": "tilt"}}
