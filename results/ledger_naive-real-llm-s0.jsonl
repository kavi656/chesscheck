{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0001", "source": "naive", "batch": null, "raw": {"statement": "After 3+ straight losses, players underperform their rating (tilt).", "subset": [], "condition": [{"feature": "streak", "op": "<=", "value": -3}], "comparison": "rest_of_subset", "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Tilt and frustration after a losing run should degrade play. The marginal means already trend negative with the loss streak."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0002", "source": "naive", "batch": null, "raw": {"statement": "After 3+ straight wins, players overperform their rating (hot hand).", "subset": [], "condition": [{"feature": "streak", "op": ">=", "value": 3}], "comparison": "rest_of_subset", "outcome": "residual", "direction": "greater", "min_effect": 0.01, "rationale": "Confidence and being in a good playing state may carry over from a winning run. The marginal mean is highest for the longest win streaks."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0003", "source": "naive", "batch": null, "raw": {"statement": "Rapid-fire games started within 3 minutes after a loss underperform.", "subset": [], "condition": [{"feature": "prev_result", "op": "==", "value": "loss"}, {"feature": "minutes_since_prev_game", "op": "<", "value": 3}], "comparison": {"condition": [{"feature": "prev_result", "op": "==", "value": "loss"}, {"feature": "minutes_since_prev_game", "op": ">=", "value": 3}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Immediate re-queueing after a loss suggests impulsive, emotional play."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0004", "source": "naive", "batch": null, "raw": {"statement": "The first game of a session is worse than later games, because the player is not warmed up.", "subset": [], "condition": [{"feature": "session_index", "op": "==", "value": 1}], "comparison": {"condition": [{"feature": "session_index", "op": ">=", "value": 3}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Players need warm-up. The marginal mean for session positions 1-2 is negative."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0005", "source": "naive", "batch": null, "raw": {"statement": "Very long sessions (index 25+) show fatigue and lower residuals.", "subset": [{"feature": "rating_band", "op": "in", "value": ["1200-1600", "1600-2000"]}], "condition": [{"feature": "session_index", "op": ">=", "value": 25}], "comparison": {"condition": [{"feature": "session_index", "op": "between", "value": [3, 15]}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Cognitive fatigue should reduce performance late in long sessions, though selection could offset it."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0006", "source": "naive", "batch": null, "raw": {"statement": "Late-night games (UTC 0-5) underperform a player's daytime games.", "subset": [{"feature": "rating_band", "op": "in", "value": ["1600-2000", "2000-2400"]}], "condition": [{"feature": "hour_utc", "op": "between", "value": [0, 5]}], "comparison": {"condition": [{"feature": "hour_utc", "op": "between", "value": [12, 20]}]}, "outcome": "residual", "direction": "less", "min_effect": 0.008, "rationale": "Sleep deprivation and late-hour fatigue should reduce play quality."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0007", "source": "naive", "batch": null, "raw": {"statement": "After the previous game ended on time forfeit, the next game is worse.", "subset": [], "condition": [{"feature": "prev_termination", "op": "==", "value": "Time forfeit"}, {"feature": "prev_result", "op": "==", "value": "loss"}], "comparison": {"condition": [{"feature": "prev_termination", "op": "==", "value": "Normal"}, {"feature": "prev_result", "op": "==", "value": "loss"}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Losing on time is especially frustrating and can induce tilt."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0008", "source": "naive", "batch": null, "raw": {"statement": "White's advantage is larger for 2400+ players than for others.", "subset": [{"feature": "rating_band", "op": "==", "value": "2400+"}], "condition": [{"feature": "color", "op": "==", "value": "white"}], "comparison": {"condition": [{"feature": "color", "op": "==", "value": "black"}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.02, "rationale": "At high levels, accurate opening play makes the first-move advantage more decisive."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0009", "source": "naive", "batch": null, "raw": {"statement": "Players rated 50+ above their opponent underperform the Elo expectation.", "subset": [], "condition": [{"feature": "elo_diff", "op": ">", "value": 50}], "comparison": {"condition": [{"feature": "elo_diff", "op": "between", "value": [-50, 50]}, {"feature": "elo_diff", "op": "between", "value": [-50, 50]}]}, "outcome": "residual", "direction": "less", "min_effect": 0.02, "rationale": "The marginals show favorites underperform and underdogs overperform, which suggests the Elo expectation is too extreme in blitz."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0010", "source": "naive", "batch": null, "raw": {"statement": "Arena tournament games produce different residuals than pool games for 1600-2000 players.", "subset": [{"feature": "rating_band", "op": "==", "value": "1600-2000"}], "condition": [{"feature": "event_type", "op": "==", "value": "tournament"}], "comparison": {"condition": [{"feature": "event_type", "op": "==", "value": "pool"}]}, "outcome": "residual", "direction": "two-sided", "min_effect": 0.01, "rationale": "Arena scoring and streak incentives change motivation and risk-taking, but the direction is unclear."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0011", "source": "naive", "batch": null, "raw": {"statement": "A very heavy day (30+ games played today) lowers performance.", "subset": [], "condition": [{"feature": "games_played_today", "op": ">=", "value": 30}], "comparison": {"condition": [{"feature": "games_played_today", "op": "between", "value": [4, 15]}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Cumulative daily fatigue should reduce performance."}}
{"ts": "2026-11-07T18:33:49.030+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0012", "source": "naive", "batch": null, "raw": {"statement": "Playing on weekends differs from weekdays for 1200-1600 players.", "subset": [{"feature": "rating_band", "op": "==", "value": "1200-1600"}], "condition": [{"feature": "weekday", "op": "in", "value": ["Sat", "Sun"]}], "comparison": {"condition": [{"feature": "weekday", "op": "in", "value": ["Mon", "Fri"]}]}, "outcome": "residual", "direction": "two-sided", "min_effect": 0.005, "rationale": "The weekend player mix and mood may differ, but there is no strong prior on direction."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0013", "source": "naive", "batch": null, "raw": {"statement": "Start-minute parity has no effect (placebo).", "subset": [], "condition": [{"feature": "start_minute_parity", "op": "==", "value": "odd"}], "comparison": {"condition": [{"feature": "start_minute_parity", "op": "==", "value": "even"}]}, "outcome": "residual", "direction": "two-sided", "min_effect": 0.005, "rationale": "This is a negative control, since parity should not matter."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0014", "source": "naive", "batch": null, "raw": {"statement": "After the previous game was abandoned, performance drops.", "subset": [], "condition": [{"feature": "prev_termination", "op": "==", "value": "Abandoned"}], "comparison": {"condition": [{"feature": "prev_termination", "op": "==", "value": "Normal"}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "An abandoned game suggests distraction or disruption, which carries into the next game."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0015", "source": "naive", "batch": null, "raw": {"statement": "After a loss streak, a cool-off break of 30+ minutes recovers performance relative to immediate continuation.", "subset": [], "condition": [{"feature": "streak", "op": "<=", "value": -2}, {"feature": "minutes_since_prev_game", "op": ">", "value": 30}], "comparison": {"condition": [{"feature": "streak", "op": "<=", "value": -2}, {"feature": "minutes_since_prev_game", "op": "<=", "value": 5}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.015, "rationale": "Taking a break allows emotional reset, while chasing losses leads to tilt."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0016", "source": "naive", "batch": null, "raw": {"statement": "Low-rated players (<1200) score better with an increment (180+2) than in 180+0 games.", "subset": [{"feature": "rating_band", "op": "==", "value": "<1200"}], "condition": [{"feature": "time_control", "op": "==", "value": "180+2"}], "comparison": {"condition": [{"feature": "time_control", "op": "==", "value": "180+0"}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.008, "rationale": "Increments reduce flagging luck, which could change outcomes versus Elo expectation. The direction is a weak prior."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0017", "source": "naive", "batch": null, "raw": {"statement": "Black players in the 1600-2000 band score worse with D-family (queen's pawn) openings.", "subset": [{"feature": "rating_band", "op": "==", "value": "1600-2000"}, {"feature": "color", "op": "==", "value": "black"}], "condition": [{"feature": "eco_family", "op": "==", "value": "D"}], "comparison": {"condition": [{"feature": "eco_family", "op": "in", "value": ["B", "C"]}]}, "outcome": "residual", "direction": "less", "min_effect": 0.01, "rationale": "Closed queen's pawn structures may suit the white side more at club level, while Black does better in sharper B and C openings."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0018", "source": "naive", "batch": null, "raw": {"statement": "After a win against a higher-rated opponent, the next game is overperformed (momentum).", "subset": [], "condition": [{"feature": "prev_result", "op": "==", "value": "win"}, {"feature": "streak", "op": "between", "value": [1, 2]}], "comparison": {"condition": [{"feature": "prev_result", "op": "==", "value": "loss"}, {"feature": "streak", "op": "between", "value": [-2, -1]}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.01, "rationale": "Short momentum after a win versus a loss should give a modest residual gap."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0019", "source": "naive", "batch": null, "raw": {"statement": "2000-2400 players do worse than usual when facing opponents rated 2400+.", "subset": [{"feature": "rating_band", "op": "==", "value": "2000-2400"}], "condition": [{"feature": "opp_rating_band", "op": "==", "value": "2400+"}], "comparison": {"condition": [{"feature": "opp_rating_band", "op": "==", "value": "2000-2400"}]}, "outcome": "residual", "direction": "two-sided", "min_effect": 0.01, "rationale": "Marginals show higher-rated opponents have a positive residual, so the Elo gap might be underestimated at the top. Direction is unclear because of compression."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0020", "source": "naive", "batch": null, "raw": {"statement": "Players who lose on time and restart within 5 minutes underperform relative to other post-loss games that ended normally.", "subset": [], "condition": [{"feature": "prev_termination", "op": "==", "value": "Time forfeit"}, {"feature": "prev_result", "op": "==", "value": "loss"}, {"feature": "minutes_since_prev_game", "op": "<=", "value": 5}], "comparison": {"condition": [{"feature": "prev_termination", "op": "==", "value": "Normal"}, {"feature": "prev_result", "op": "==", "value": "loss"}, {"feature": "minutes_since_prev_game", "op": "<=", "value": 5}]}, "outcome": "residual", "direction": "less", "min_effect": 0.005, "rationale": "A time-forfeit loss is a more avoidable and frustrating loss than a normal one. A quick restart suggests tilt, so the effect should be larger than the null result for any forfeit-preceded game."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0021", "source": "naive", "batch": null, "raw": {"statement": "The first game or two of a UTC day underperform later games that day, because the player is cold and has not settled in.", "subset": [], "condition": [{"feature": "games_played_today", "op": "<=", "value": 1}], "comparison": {"condition": [{"feature": "games_played_today", "op": ">=", "value": 4}]}, "outcome": "residual", "direction": "less", "min_effect": 0.007, "rationale": "Marginal means show games_played_today <=1 at -0.007 and later games positive. Heavy-day fatigue was not supported, so the warm-up side of the pattern is the one to test."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0022", "source": "naive", "batch": null, "raw": {"statement": "Mid-to-late session games (index 8+) outperform the opening two games of a session.", "subset": [], "condition": [{"feature": "session_index", "op": ">=", "value": 8}], "comparison": {"condition": [{"feature": "session_index", "op": "<=", "value": 2}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.007, "rationale": "The fatigue hypothesis failed and the sign was positive. Marginal means show session_index 7+ at +0.005 against -0.004 for the first two games, so this tests warm-up persisting beyond the first game."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0023", "source": "naive", "batch": null, "raw": {"statement": "2000-2400 players do better in increment time controls (180+2, 300+3) than in zero-increment 180+0 games.", "subset": [{"feature": "rating_band", "op": "==", "value": "2000-2400"}], "condition": [{"feature": "time_control", "op": "in", "value": ["180+2", "300+3"]}], "comparison": {"condition": [{"feature": "time_control", "op": "==", "value": "180+0"}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.005, "rationale": "The low-rated increment effect was null or negative. Stronger players convert winning positions better with an increment and are less exposed to flag-based coin flips, so skill should be rewarded more."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0024", "source": "naive", "batch": null, "raw": {"statement": "2000-2400 players in arena tournament games underperform their own pool games.", "subset": [{"feature": "rating_band", "op": "==", "value": "2000-2400"}], "condition": [{"feature": "event_type", "op": "==", "value": "tournament"}], "comparison": {"condition": [{"feature": "event_type", "op": "==", "value": "pool"}]}, "outcome": "residual", "direction": "less", "min_effect": 0.005, "rationale": "Tournament games showed a negative residual for the 1600-2000 band. Arena pairings and streak-driven play may produce a similar negative effect for stronger players."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0025", "source": "naive", "batch": null, "raw": {"statement": "Late-night UTC (0-5) games on Fri/Sat/Sun overperform the same players' other games, because opponent pools are weaker or more casual relative to rating.", "subset": [{"feature": "weekday", "op": "in", "value": ["Fri", "Sat", "Sun"]}], "condition": [{"feature": "hour_utc", "op": "between", "value": [0, 5]}], "comparison": {"condition": [{"feature": "hour_utc", "op": "between", "value": [8, 20]}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.005, "rationale": "The original late-night underperformance hypothesis came out slightly positive. The refinement flips the direction and restricts to weekends, where late-night play is more recreational."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0026", "source": "naive", "batch": null, "raw": {"statement": "For 1200-1600 players, the first game of a UTC day (0 games played earlier today) underperforms their own games later in the day, with a stronger effect when the previous game was more than 6 hours earlier.", "subset": [{"feature": "rating_band", "op": "==", "value": "1200-1600"}], "condition": [{"feature": "games_played_today", "op": "==", "value": 0}], "comparison": {"condition": [{"feature": "games_played_today", "op": ">=", "value": 4}]}, "outcome": "residual", "direction": "less", "min_effect": 0.008, "rationale": "The marginal mean for games_played_today <=1 is -0.007 versus +0.002 to +0.004 later in the day. The previous test pooled the first two games and diluted the effect. Restricting to the very first game and comparing it with games 5 and later should sharpen the contrast."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0027", "source": "naive", "batch": null, "raw": {"statement": "For 2000-2400 players, games in zero-increment 180+0 underperform relative to 300+0 games, since flagging risk in 3-minute games without increment hurts stronger players relative to their ratings.", "subset": [{"feature": "rating_band", "op": "==", "value": "2000-2400"}], "condition": [{"feature": "time_control", "op": "==", "value": "180+0"}], "comparison": {"condition": [{"feature": "time_control", "op": "==", "value": "300+0"}]}, "outcome": "residual", "direction": "less", "min_effect": 0.006, "rationale": "The earlier increment versus no-increment comparison found nothing, possibly because 180+2 and 300+3 are different formats. A direct comparison of 180+0 with 300+0 isolates the effect of base time. Rating-specific blitz ratings should differ most for very short zero-increment games, where premove and flagging skill matter."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0028", "source": "naive", "batch": null, "raw": {"statement": "For players under 1600, the first game of a UTC day after a long break (more than 6 hours since the previous game) underperforms their own later games, with the effect sharper than in the broader first-game-of-day test.", "subset": [{"feature": "rating_band", "op": "in", "value": ["<1200", "1200-1600"]}], "condition": [{"feature": "games_played_today", "op": "==", "value": 0}, {"feature": "minutes_since_prev_game", "op": ">", "value": 360}], "comparison": {"condition": [{"feature": "games_played_today", "op": ">=", "value": 2}]}, "outcome": "residual", "direction": "less", "min_effect": 0.004, "rationale": "The marginal mean for 0-1 games today is -0.007, so a cold-start effect appears to exist. The 1200-1600-only test was borderline (-0.0017, p=0.052). Widening to both lower bands and requiring a long rest gap while comparing against clearly warmed-up games (2+ games today) should sharpen the contrast."}}
{"ts": "2026-11-07T18:33:49.031+00:00", "run": "naive-real-llm-s0", "type": "proposed", "id": "H0029", "source": "naive", "batch": null, "raw": {"statement": "For 2000-2400 players, 180+0 games overperform relative to their 300+0 games, which reverses the earlier flagging-risk hypothesis.", "subset": [{"feature": "rating_band", "op": "==", "value": "2000-2400"}], "condition": [{"feature": "time_control", "op": "==", "value": "180+0"}], "comparison": {"condition": [{"feature": "time_control", "op": "==", "value": "300+0"}]}, "outcome": "residual", "direction": "greater", "min_effect": 0.0025, "rationale": "The previous test found a positive effect (+0.0027) against my predicted negative one. Strong players may have a relative edge in fast premove-heavy games because of speed and intuition, so I flip the direction in line with the observed sign."}}
{"ts": "2026-11-07T18:33:49.286+00:00", "run": "naive-real-llm-s0", "type": "stage", "id": "H0001", "stage": "explore", "effect": -0.0084153051, "ci_low": -0.0095712045, "ci_high": -0.0072594058, "p": 1.6972703e-46, "z": -14.269407, "se": 0.00058974457, "raw_diff": -0.0073848848, "n_treated": 916345, "n_control": 7512047, "n_players": 203949, "underpowered": false, "s_centered": -24195.91, "var_s": 2875226.7, "scale": 3.4779866e-07}
