{"ts": "2026-11-07T18:33:49.829+00:00", "run": "naive-real-llm-s0", "type": "stage", "id": "H0003", "stage": "explore", "effect": -0.0038484708, "ci_low": -0.005418836, "ci_high": -0.0022781055, "p": 7.8019145e-07, "z": -4.8033429, "se": 0.00080120674, "raw_diff": -0.0048919167, "n_treated": 440863, "n_control": 3521304, "n_players": 142773, "underpowered": false, "s_centered": -5995.1354, "var_s": 1557796.8, "scale": 6.4193225e-07}
{"ts": "2026-11-07T18:33:50.188+00:00", "run": "naive-real-llm-s0", "type": "stage", "id": "H0004", "stage": "explore", "effect": -0.007068224, "ci_low": -0.0078439974, "ci_high": -0.0062924507, "p": 1.2534621e-71, "z": -17.857947, "se": 0.00039580272, "raw_diff": -0.0073586403, "n_treated": 2319019, "n_control": 4669661, "n_players": 294078, "underpowered": false, "s_centered": -45118.302, "var_s": 6383258.6, "scale": 1.566598e-07}
